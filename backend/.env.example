# Comma-separated list of origins allowed to call this API. Defaults to the
# common local dev (5173) and preview (4173) ports if unset — override for
# production with your deployed frontend URL(s).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Supabase project URL (same as VITE_SUPABASE_URL). Used to check sign-in tokens; no secret key needed.
SUPABASE_URL=https://jyvivwpbljllmtcqnymk.supabase.co

# Optional: Per-IP sliding-window rate limit per minute for /api/analyze, /api/fetch-media, and /api/youtube/search (set 0 to disable).
ANALYZE_RATE_LIMIT_PER_MINUTE=60

# Optional: Google Gemini API key for /api/assistant. Falls back to the built-in song-grounded tutor if unset.
# GEMINI_API_KEY=

# ── Analysis pipeline (job-based: POST /api/pipeline/jobs, poll GET /api/pipeline/jobs/{id}) ──
# Which engine the app uses: v2 (existing librosa engine, default) or pipeline.
# The pipeline endpoints work under either setting, so both can be compared.
# ANALYSIS_ENGINE=v2
# Where jobs, temp audio and the SQLite results cache live (default: backend/pipeline_data).
# PIPELINE_DATA_DIR=
# A job is stopped after this many seconds (default 1800).
# PIPELINE_JOB_TIMEOUT_SECONDS=1800
# FFmpeg extraction timeout in seconds (default 180).
# PIPELINE_FFMPEG_TIMEOUT_SECONDS=180
# Longest audio accepted, in seconds (default 900 = 15 min).
# PIPELINE_MAX_AUDIO_SECONDS=900
# Device for Demucs stem separation (pipeline and Stems page): cpu (default), cuda, cuda:N or mps.
# An unavailable GPU falls back to the CPU with a warning in the result.
# DEMUCS_DEVICE=cpu
# 1 = keep pipeline_data/jobs/<id>/stems/{vocals,no_vocals,drums}.wav after a successful job (for listening/debugging).
# PIPELINE_KEEP_STEMS=0
# Rhythm/structure engine: auto (allin1 through WSL2, else beat_this), allin1 (no fallback) or beat_this.
# Only allin1 returns song sections; with beat_this, sections stay empty.
# PIPELINE_RHYTHM_ENGINE=auto
# 0 = never try WSL2/allin1 (auto then goes straight to beat_this).
# PIPELINE_WSL_ENABLED=1
# Command that starts the WSL2 Python which has allin1 installed (forward slashes; Windows paths are
# translated to /mnt/<drive>/...). Default: wsl.exe -d Ubuntu -- python3
# PIPELINE_WSL_COMMAND=wsl.exe -d Ubuntu -- /home/<you>/allin1-env/bin/python
# Seconds one rhythm engine may run before it is stopped (default 900; the job timeout still applies).
# PIPELINE_RHYTHM_TIMEOUT_SECONDS=900
# Chord engine: auto (BTC, else lv-chordia if it is already installed with its weights), btc or lv_chordia.
# BTC is puar-playground/btc-chord on Hugging Face, pinned to one reviewed commit (needs: pip install transformers;
# ~24 MB downloaded once into the Hugging Face cache, HF_HOME).
# PIPELINE_CHORD_ENGINE=auto
# Device for BTC: cpu (default), cuda, cuda:N or mps. lv-chordia picks CUDA by itself when torch sees a GPU.
# PIPELINE_CHORD_DEVICE=cpu
# Seconds chord recognition may run before it is stopped (default 600; the job timeout still applies).
# PIPELINE_CHORD_TIMEOUT_SECONDS=600
