    "beats": "seconds, ascending",
    "downbeats": "seconds, ascending",
    "chords": "[{\"start\": s, \"end\": s, \"chord\": \"Am7\" | \"G/B\" | \"N\"}] - app symbols",
    "main_chord_progression": "the repeating loop, untimed: [\"Am\",\"F\",\"C\",\"G\"]",
    "sections": "[{\"start\": s, \"end\": s, \"label\": \"verse\"}]",
    "passing_chords": "start time of each passing chord, seconds; [] = verified none",
    "fills": "[seconds | {\"start\": s, \"end\": s}] drum fills; [] = verified none",
    "expected_warnings": "preprocessing warning categories that SHOULD fire: clipping, low_volume, noise, speech, no_instruments, not_musical, quiet_instruments, stem_clipping; [] = none should fire"
